FROM node:22-alpine AS frontend
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build
FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8000 HOST=0.0.0.0
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.115.14 "uvicorn>=0.30,<1" "websockets>=14,<17"
RUN useradd --create-home --uid 10001 appuser && mkdir /app/runtime && chown appuser /app/runtime
COPY adaptive_defense/api ./adaptive_defense/api
COPY runs/demo/console.json ./runs/demo/console.json
COPY --from=frontend /web/dist ./web/dist
COPY serve_api.py ./
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('PORT','8000')+'/api/health',timeout=4)"
CMD ["python", "serve_api.py"]
